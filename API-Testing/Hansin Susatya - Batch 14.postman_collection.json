	"item": [
		{
			"name": "Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const response = pm.response.json()",
							"const schema = {",
							"  \"$schema\": \"http://json-schema.org/draft-07/schema#\",",
							"  \"title\": \"Generated schema for Root\",",
							"  \"type\": \"object\",",
							"  \"properties\": {",
							"    \"status\": {",
							"      \"type\": \"number\"",
							"    },",
							"    \"token\": {",
							"      \"type\": \"string\"",
							"    },",
							"    \"message\": {",
							"      \"type\": \"string\"",
							"    }",
							"  },",
							"  \"required\": [",
							"    \"status\",",
							"    \"token\",",
							"    \"message\"",
							"  ]",
							"}",
							"",
							"pm.collectionVariables.set('token', response.token)",
							"",
							"pm.test('Validate response schema', () => {",
							"    pm.response.to.have.jsonSchema(schema);",
							"})",
							"",
							"pm.test(\"Status code is 200\", () => {",
							"    pm.response.to.have.status(200)",
							"})",
							"",
							"pm.test(\"Request body have username and password property\", () => {",
							"    const raw = pm.request.body?.raw || \"\";",
							"    let body;",
							"    try {",
							"        body = JSON.parse(raw)",
							"    } catch(e) {",
							"        pm.expect.fail(\"Request body is not valid JSON. Raw was: \" + raw);",
							"    }",
							"    pm.expect(body).to.have.property('username')",
							"    pm.expect(body).to.have.property('password')",
							"    pm.expect(body.username).to.eql('admin');",
							"})",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "https://belajar-bareng.onrender.com/api/login",
					"protocol": "https",
					"host": [
						"belajar-bareng",
						"onrender",
						"com"
					],
					"path": [
						"api",
						"login"
					]
				}
			},
			"response": []
		},
